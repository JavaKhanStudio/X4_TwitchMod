<?xml version="1.0" encoding="utf-8"?>
<!--
  Twitch Integration — Mission Director script (game-logic layer).

  Responsibilities:
    * lifecycle: open the pipe and start a continuous read on game load
    * inbound:  raw line from pipe -> Lua (JSON decode) -> typed UI event -> MD cue -> effect
    * outbound: build a small JSON line and Named_Pipes.Write it back to the bridge

  Transport is the Mod Support APIs "Named Pipes API". On native Linux the bekopharm
  linux-compat fork backs that API with a Unix-domain socket in the savegame folder,
  so this same MD code works on Linux. The pipe NAME here ("twitch") maps to the
  socket file via the API's "Pipe Prefix Linux" option.

  VERIFIED against sn_mod_support_apis source:
    * md.Named_Pipes.Read  param="table[$pipe=.., $cue=.., $continuous=true]";
      callback reads the line from event.param ('ERROR'/'CANCELLED'/'TIMEOUT' sentinels).
    * md.Named_Pipes.Write param="table[$pipe=.., $msg=.., $cue=..]"; callback event.param
      is 'SUCCESS'/'ERROR'. No explicit open needed (connects on first access).
    * Lua-emitted typed events arrive with the payload in event.param3.
  STILL [VERIFY] live: (a) Linux pipe-name -> socket-file mapping via the fork's
  "Pipe Prefix Linux" option; (b) whether to pass structured fields as an MD table
  via param3 instead of the raw JSON string (see Twitch_OnChat).
  Effects below are debug log lines; real gameplay replaces the TODO markers.
-->
<mdscript name="Twitch_Integration" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>

    <!-- ===== lifecycle ===================================================== -->
    <!-- Start (and restart) the pipe read when the Named Pipes API signals it is
         READY. md.Named_Pipes.Reloaded fires after the API's lua has loaded and
         set its globals to enabled — on new game, savegame load, and ui reload —
         and always AFTER our MD cues are registered (guaranteed in named_pipes.xml:
         "the lua signal will always arrive after md cues are set up").
         Triggering off event_game_started instead (our old bug) called Read before
         the API was enabled, so the read was silently dropped and the socket never
         opened. The host's own x4_python_host socket appeared but ours did not.
         Verified against sn_mod_support_apis/md/named_pipes.xml on X4 8.00 (2026-06-09). -->
    <cue name="Twitch_OnPipesReady" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Named_Pipes.Reloaded"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] Named_Pipes ready; starting pipe read'" filter="general"/>
        <signal_cue_instantly cue="Twitch_StartReading"/>
      </actions>
    </cue>

    <!-- Start a continuous read on the pipe; each line invokes Twitch_OnPipeData.
         Signalled by Twitch_OnPipesReady, and re-signalled by Twitch_OnPipeData
         after a pipe error/close so the read loop self-heals. -->
    <cue name="Twitch_StartReading" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Named_Pipes.Read"
          param="table[$pipe='twitch', $cue=Twitch_OnPipeData, $continuous=true]"/>
      </actions>
    </cue>

    <!-- One raw line arrived from the bridge. Hand it to Lua to decode. -->
    <cue name="Twitch_OnPipeData" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$line" exact="event.param"/>
        <do_if value="$line == 'ERROR' or $line == 'CLOSED'">
          <debug_text text="'[Twitch] pipe error/closed; will retry'" filter="general"/>
          <!-- simple backoff then restart the read loop -->
          <signal_cue cue="Twitch_StartReading" delay="2s"/>
        </do_if>
        <do_else>
          <raise_lua_event name="'Twitch.Decode'" param="$line"/>
        </do_else>
      </actions>
    </cue>

    <!-- ===== inbound VETTED COMMANDS (one cue per catalog action id) ========
         The bridge applies permissions/cooldowns and sends {"t":"cmd","id":<action>,
         "by":<user>,"args":{...}}. Lua emits <action> as the `control`, so each
         action gets its own cue. event.param3 holds the raw JSON line.
         Add a cue here whenever you add a Command to bridge/twitch_bridge/catalog.py.
         Effects are debug_text placeholders — replace the TODOs with real gameplay. -->

    <cue name="Twitch_OnPing" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'ping'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] ping'" filter="general"/>
        <signal_cue_instantly cue="Twitch_Say" param="'pong'"/>
      </actions>
    </cue>

    <!-- DIAGNOSTIC: echo the single arg MD receives back to chat, to isolate the
         arg-passing path (bridge -> lua flat table -> MD read). If '!argtest hello'
         replies "argtest OK: [hello]" the whole path works; "NO ARG" means the arg
         didn't arrive; no reply at all means this updated mod isn't loaded (reload
         the save / restart X4). Remove once args are confirmed working. -->
    <cue name="Twitch_OnArgTest" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'argtest'"/>
      </conditions>
      <actions>
        <!-- non-incident commands send a plain ';'-joined string; echo it. -->
        <set_value name="$s" exact="@event.param3"/>
        <do_if value="$s?">
          <signal_cue_instantly cue="Twitch_Say" param="'argtest str=[' + $s + ']'"/>
        </do_if>
        <do_else>
          <signal_cue_instantly cue="Twitch_Say" param="'argtest str=NULL'"/>
        </do_else>
      </actions>
    </cue>

    <!-- Report the player's COMBAT (fight) rank to chat. Read-only query, no args.
         X4 tracks fighting as global statistics (libraries/stats.xml), not as a
         player property:
           * stat.fight_rank    — the named combat rank: a level 0..30 mapped from
                                  fight_score by the <mapto> table in stats.xml.
           * stat.fight_score   — the accumulated weighted score that drives the rank
                                  (small-ship kill +1, capital +30, module +10,
                                  turret +3, ...; all integer, so it stays whole).
           * stat.ships_destroyed — the raw kill count (what chat calls "kills").
         READ IDIOM (verified LIVE 2026-07-04): the global stat keyword returns the
         numeric value DIRECTLY and BARE — `@stat.<id>` IS the number, never
         `stat.<id>.value` and never guarded with `?` (the `?`/`.exists`/`.value`
         forms all fail on it and read as null; that was the original bug). Mirrors
         vanilla md/notifications.xml `value="@stat.sectors_discovered"`. `@` yields
         null for a stat not yet recorded, so read into a var and coalesce to 0.
         The rank NAME is not on the stat; fetch it from the TextDB by rank number:
         readtext.{20219}.{2001 + 10*rank} (Harmless=0 .. Commander=14 .. X-TREME=30).
         $nextscore mirrors the fight_rank <mapto> thresholds in stats.xml (X4 8.00):
         $nextscore.{r} = min fight_score to REACH rank r, so "kills to next" is
         reported as fight score to the next threshold (rank is score-, not
         kill-based, so an exact kill count to next can't be given). -->
    <cue name="Twitch_OnRank" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'rank'"/>
      </conditions>
      <actions>
        <!-- read bare + unguarded; coalesce a not-yet-recorded (null) stat to 0 -->
        <set_value name="$rank"  exact="@stat.fight_rank"/>
        <set_value name="$score" exact="@stat.fight_score"/>
        <set_value name="$kills" exact="@stat.ships_destroyed"/>
        <do_if value="not $rank?"><set_value name="$rank" exact="0"/></do_if>
        <do_if value="not $score?"><set_value name="$score" exact="0"/></do_if>
        <do_if value="not $kills?"><set_value name="$kills" exact="0"/></do_if>

        <!-- rank title from the TextDB (page 20219, id 2001 + 10*rank) -->
        <set_value name="$title" exact="readtext.{20219}.{2001 + 10 * $rank}"/>

        <!-- min fight_score to REACH ranks 1..30 (index r -> rank r) -->
        <set_value name="$nextscore" exact="[1, 3, 5, 7, 10, 14, 20, 29, 42, 60, 87, 130, 190, 280, 410, 590, 860, 1200, 1700, 2500, 3600, 5200, 7500, 11000, 16000, 23000, 33000, 48000, 70000, 100000]"/>

        <set_value name="$msg" exact="'Commander combat rank: ' + $title + ' (rank ' + $rank + '/30) — ' + $kills + ' ships destroyed'"/>
        <do_if value="$rank ge 30">
          <set_value name="$msg" exact="$msg + '. Maximum fight rank reached!'"/>
        </do_if>
        <do_else>
          <set_value name="$need" exact="$nextscore.{$rank + 1} - $score"/>
          <do_if value="$need lt 1"><set_value name="$need" exact="1"/></do_if>
          <set_value name="$msg" exact="$msg + '. ' + $need + ' more fight score to rank ' + ($rank + 1) + '.'"/>
        </do_else>

        <debug_text text="'[Twitch] rank: %s (r%s score %s kills %s)'.[$title, $rank, $score, $kills]" filter="general"/>
        <signal_cue_instantly cue="Twitch_Say" param="$msg"/>
      </actions>
    </cue>

    <!-- Report the player's ECONOMIC (trade) rank to chat. Symmetric to the combat
         cue above: stat.trade_rank is a level 0..30 mapped from stat.trade_score
         (both read bare + unguarded, see the combat cue's notes). Names live on the
         same TextDB page 20219 but id 1001 + 10*rank (Salesman=0 .. X-TREME=30).
         $nextscore mirrors the trade_rank <mapto> thresholds in stats.xml (min
         trade_score to REACH each rank). -->
    <cue name="Twitch_OnTradeRank" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'traderank'"/>
      </conditions>
      <actions>
        <set_value name="$rank"  exact="@stat.trade_rank"/>
        <set_value name="$score" exact="@stat.trade_score"/>
        <do_if value="not $rank?"><set_value name="$rank" exact="0"/></do_if>
        <do_if value="not $score?"><set_value name="$score" exact="0"/></do_if>

        <set_value name="$title" exact="readtext.{20219}.{1001 + 10 * $rank}"/>
        <set_value name="$nextscore" exact="[1, 8, 18, 32, 57, 100, 180, 320, 580, 1000, 1800, 3200, 5800, 10000, 18000, 32000, 58000, 100000, 180000, 320000, 580000, 1000000, 1800000, 3200000, 5800000, 10000000, 18000000, 32000000, 58000000, 100000000]"/>

        <set_value name="$msg" exact="'Commander trade rank: ' + $title + ' (rank ' + $rank + '/30)'"/>
        <do_if value="$rank ge 30">
          <set_value name="$msg" exact="$msg + '. Maximum trade rank reached!'"/>
        </do_if>
        <do_else>
          <set_value name="$need" exact="$nextscore.{$rank + 1} - $score"/>
          <do_if value="$need lt 1"><set_value name="$need" exact="1"/></do_if>
          <set_value name="$msg" exact="$msg + '. ' + $need + ' more trade score to rank ' + ($rank + 1) + '.'"/>
        </do_else>

        <debug_text text="'[Twitch] traderank: %s (r%s score %s)'.[$title, $rank, $score]" filter="general"/>
        <signal_cue_instantly cue="Twitch_Say" param="$msg"/>
      </actions>
    </cue>

    <!-- ===== generic "level up" watcher (data-driven poll) ==================
         X4 exposes NO rank-change event (searched vanilla md 2026-07-04), so we
         POLL. This is a REUSABLE pattern: a single self-signalling loop watches a
         LIST of metrics and shouts in chat whenever any of them rises. To track a
         new rank, add ONE read (into a var, null->0) plus ONE row to $metrics — the
         compare/announce/carry-forward logic below is metric-agnostic. State (the
         previous snapshot) rides forward in the loop's own signal param, so no
         cross-cue variables are needed.

         Each $metrics row is a table:
           $label  chat word for the announce ("Combat", "Trade", ...)
           $page   TextDB page for the rank name
           $base   name id = readtext.{$page}.{$base + 10 * value}
           $max    top rank (shown as "/N")
           $cur    the freshly-read current level (null coalesced to 0)

         Twitch_RankWatchStart (re)seeds on every Named_Pipes.Reloaded (new game /
         save load / ui reload) and CANCELS the running loop first (cancel_cue also
         cancels the instance waiting in <delay>), so a reload can never stack a
         second poller. The first tick after (re)seed has no prior snapshot (null
         param) and only establishes the baseline — so it never fires a false
         level-up from a stale value; the trade-off is that a rank-up within the
         first ~20s after a load isn't announced. -->
    <cue name="Twitch_RankWatchStart" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Named_Pipes.Reloaded"/>
      </conditions>
      <actions>
        <cancel_cue cue="Twitch_RankWatch"/>
        <signal_cue cue="Twitch_RankWatch"/>   <!-- no param => baseline seed tick -->
      </actions>
    </cue>

    <cue name="Twitch_RankWatch" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <delay exact="20s"/>
      <actions>
        <!-- ===== TRACKED METRICS — the ONLY per-rank part (read + one row) ==== -->
        <set_value name="$vFight" exact="@stat.fight_rank"/>
        <do_if value="not $vFight?"><set_value name="$vFight" exact="0"/></do_if>
        <set_value name="$vTrade" exact="@stat.trade_rank"/>
        <do_if value="not $vTrade?"><set_value name="$vTrade" exact="0"/></do_if>

        <set_value name="$metrics" exact="[]"/>
        <append_to_list name="$metrics" exact="table[$label='Combat', $page=20219, $base=2001, $max=30, $cur=$vFight]"/>
        <append_to_list name="$metrics" exact="table[$label='Trade', $page=20219, $base=1001, $max=30, $cur=$vTrade]"/>

        <!-- ===== generic compare + announce (metric-agnostic) ================ -->
        <do_if value="@event.param?">   <!-- prior snapshot exists: compare rows by index -->
          <set_value name="$prev" exact="event.param"/>
          <set_value name="$i" exact="1"/>
          <do_while value="$i le $metrics.count">
            <set_value name="$m" exact="$metrics.{$i}"/>
            <set_value name="$old" exact="0"/>
            <do_if value="$i le $prev.count">
              <set_value name="$old" exact="$prev.{$i}.$cur"/>
            </do_if>
            <do_if value="$m.$cur gt $old">
              <set_value name="$name" exact="readtext.{$m.$page}.{$m.$base + 10 * $m.$cur}"/>
              <signal_cue_instantly cue="Twitch_Say"
                param="'LEVEL UP! ' + $m.$label + ' rank increased to ' + $name + ' (rank ' + $m.$cur + '/' + $m.$max + ')!'"/>
            </do_if>
            <set_value name="$i" exact="$i + 1"/>
          </do_while>
        </do_if>
        <!-- else: seed tick — silently establish the baseline -->

        <!-- re-arm the loop, carrying this snapshot forward as the new baseline -->
        <signal_cue cue="Twitch_RankWatch" param="$metrics"/>
      </actions>
    </cue>

    <cue name="Twitch_OnSpawn" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'spawn'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] swarm spawn requested'" filter="general"/>
        <!-- Spawn a fleet of 20 player-owned Argon scouts next to the player, named
             Twitch 2..21 (Twitch 1 already exists). Position relative to the occupied
             ship when flying, else the player character (on foot); spread along x so
             they form a visible wall. All elements verbatim from the game's own MD;
             rename via <set_object_name> (operators 'le'/'+' and 'Twitch %s'.[$n]
             format verified against the game's MD). -->
        <do_if value="player.occupiedship.exists">
          <set_value name="$ref" exact="player.occupiedship"/>
        </do_if>
        <do_else>
          <set_value name="$ref" exact="player.entity"/>
        </do_else>
        <do_if value="$ref.exists">
          <set_value name="$n" exact="2"/>
          <do_while value="$n le 21">
            <create_ship name="$twitch_ship" macro="ship_arg_s_scout_01_a_macro" zone="player.zone">
              <owner exact="faction.player" overridenpc="true"/>
              <pilot>
                <select race="[race.argon, race.paranid, race.teladi]" tags="tag.aipilot"/>
              </pilot>
              <safepos object="$ref" x="($n - 11) * 0.2km" y="0" z="2km"/>
            </create_ship>
            <do_if value="$twitch_ship?">
              <set_object_name object="$twitch_ship" name="'Twitch %s'.[$n]"/>
            </do_if>
            <set_value name="$n" exact="$n + 1"/>
          </do_while>
          <debug_text text="'[Twitch] swarm spawned: Twitch 2..%s'.[$n - 1]" filter="general"/>
        </do_if>
        <do_else>
          <debug_text text="'[Twitch] swarm skipped: no player ref'" filter="general"/>
        </do_else>
      </actions>
    </cue>

    <!-- Spawn a hostile squad owned by the 'twitchfoe' faction (at war with the
         player; see libraries/factions.xml) and order it to hunt the player.
         Ship/order/loadout syntax verified against the game's md/gm_ambush.xml. -->
    <cue name="Twitch_OnPirateAttack" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'pirate_attack'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] pirate_attack'" filter="general"/>
        <do_if value="player.occupiedship.exists">
          <set_value name="$ref" exact="player.occupiedship"/>
        </do_if>
        <do_else>
          <set_value name="$ref" exact="player.entity"/>
        </do_else>
        <do_if value="$ref.exists">
          <set_value name="$n" exact="1"/>
          <do_while value="$n le 5">
            <create_ship name="$foe" macro="ship_arg_s_fighter_02_a_macro" zone="player.zone">
              <owner exact="faction.twitchfoe" overridenpc="true"/>
              <pilot>
                <select race="race.argon" tags="tag.aipilot"/>
              </pilot>
              <loadout>
                <quantity exact="1.0"><variation exact="0"/></quantity>
                <quality exact="0.4"/>
              </loadout>
              <orientation refobject="$ref" orientation="look_at"/>
              <safepos object="$ref" x="($n - 3) * 0.4km" y="0" z="4km"/>
            </create_ship>
            <do_if value="$foe?">
              <set_object_name object="$foe" name="'Twitch Raider %s'.[$n]"/>
              <cancel_all_orders object="$foe"/>
              <create_order object="$foe" id="'Patrol'" default="true"/>
              <create_order object="$foe" id="'Attack'" immediate="true">
                <param name="primarytarget" value="player.ship"/>
                <param name="secondarytargets" value="player.ship.subordinates"/>
                <param name="pursuetargets" value="true"/>
                <param name="allowothertargets" value="true"/>
                <param name="checkrelation" value="true"/>
              </create_order>
            </do_if>
            <set_value name="$n" exact="$n + 1"/>
          </do_while>
          <debug_text text="'[Twitch] spawned Twitch Raiders (hostile)'" filter="general"/>
        </do_if>
      </actions>
    </cue>

    <!-- Spawn a friendly squad owned by the 'twitchally' faction (allied with the
         player). If the player is flying, they join the player's fleet as
         defenders; otherwise they patrol the sector (engaging Twitch Raiders,
         since twitchally is at war with twitchfoe). -->
    <cue name="Twitch_OnReinforcements" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'reinforcements'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] reinforcements'" filter="general"/>
        <do_if value="player.occupiedship.exists">
          <set_value name="$ref" exact="player.occupiedship"/>
        </do_if>
        <do_else>
          <set_value name="$ref" exact="player.entity"/>
        </do_else>
        <do_if value="$ref.exists">
          <set_value name="$n" exact="1"/>
          <do_while value="$n le 4">
            <create_ship name="$ally" macro="ship_arg_s_fighter_02_a_macro" zone="player.zone">
              <owner exact="faction.twitchally" overridenpc="true"/>
              <pilot>
                <select race="race.argon" tags="tag.aipilot"/>
              </pilot>
              <loadout>
                <quantity exact="1.0"><variation exact="0"/></quantity>
                <quality exact="0.4"/>
              </loadout>
              <orientation refobject="$ref" orientation="look_at"/>
              <safepos object="$ref" x="($n - 2) * 0.4km" y="0" z="1.5km"/>
            </create_ship>
            <do_if value="$ally?">
              <set_object_name object="$ally" name="'Twitch Ally %s'.[$n]"/>
              <cancel_all_orders object="$ally"/>
              <do_if value="player.occupiedship.exists">
                <create_order id="'AssignCommander'" object="$ally">
                  <param name="commander" value="player.occupiedship"/>
                  <param name="assignment" value="assignment.defend"/>
                  <param name="cancelorders" value="true"/>
                </create_order>
              </do_if>
              <do_else>
                <create_order object="$ally" id="'Patrol'" default="true"/>
              </do_else>
            </do_if>
            <set_value name="$n" exact="$n + 1"/>
          </do_while>
          <signal_cue_instantly cue="Twitch_Say" param="'Reinforcements have arrived!'"/>
        </do_if>
      </actions>
    </cue>

    <!-- Buy the PLAYER any ship, with a RANDOM loadout. The bridge (ships.py) picks
         the ship, charges coins scaled to its value, and sends the chosen macro as
         the single arg -> the ui lua ';'-joins arg values, so event.param3 IS the
         macro string (e.g. "ship_ter_m_corvette_01_a_macro"). We turn that string
         into a macro with macro.{$macro} (base-game idiom, verified in 08.dat) and
         create_ship it, player-owned beside the player. "Equip at random" = a rolled
         equipment quality (0.3..1.0, int roll/10 => known-good float) + weapon-count
         <variation>, same loadout idiom as the spawn/pirate/reinforcement cues. -->
    <cue name="Twitch_OnGiftShip" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'gift_ship'"/>
      </conditions>
      <actions>
        <set_value name="$macro" exact="@event.param3"/>
        <debug_text text="'[Twitch] gift ship: %s'.[$macro]" filter="general"/>
        <do_if value="player.occupiedship.exists">
          <set_value name="$ref" exact="player.occupiedship"/>
        </do_if>
        <do_else>
          <set_value name="$ref" exact="player.entity"/>
        </do_else>
        <do_if value="$ref.exists and $macro?">
          <!-- random equipment quality 0.3..1.0 (roll int / 10 => known-good float) -->
          <set_value name="$qr" min="3" max="10"/>
          <set_value name="$q" exact="$qr / 10.0"/>
          <create_ship name="$gift" macro="macro.{$macro}" zone="player.zone">
            <owner exact="faction.player" overridenpc="true"/>
            <pilot>
              <select race="[race.argon, race.paranid, race.teladi]" tags="tag.aipilot"/>
            </pilot>
            <loadout>
              <quantity exact="1.0"><variation exact="0.5"/></quantity>
              <quality exact="$q"/>
            </loadout>
            <safepos object="$ref" x="0" y="0" z="3km"/>
          </create_ship>
          <do_if value="$gift?">
            <set_object_name object="$gift" name="'Twitch Gift'"/>
            <debug_text text="'[Twitch] ship gifted from %s (quality %s)'.[$macro, $q]" filter="general"/>
            <signal_cue_instantly cue="Twitch_Say"
              param="'A new ship has been delivered to the player (random loadout).'"/>
          </do_if>
        </do_if>
        <do_else>
          <debug_text text="'[Twitch] ship gift skipped: no player ref or macro'" filter="general"/>
        </do_else>
      </actions>
    </cue>

    <cue name="Twitch_OnSubReward" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'sub_reward'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] sub_reward'" filter="general"/>
        <!-- TODO: grant a perk to the player -->
      </actions>
    </cue>

    <cue name="Twitch_OnCheerBoost" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'cheer_boost'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] cheer_boost'" filter="general"/>
        <!-- TODO: temporary boost scaled by args.$bits -->
      </actions>
    </cue>

    <!-- NPC Faction Incident: shift the standing between two NPC factions using the
         game's own diplomacy hook (add_faction_relation, verified against
         md/diplomacy.xml). The two factions come from the !buy args
         (event.param3.$args.$faction1 / $faction2, passed as a table by the ui lua);
         if omitted or not recognised, two random distinct factions are chosen.
         Sours their relation by 0.10..0.20 so repeated incidents can flip neutrals
         toward war. The $byKey map + $factions list MIRROR the faction keys listed
         in bridge catalog.py (faction_incident description). -->
    <cue name="Twitch_OnFactionIncident" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'faction_incident'"/>
      </conditions>
      <actions>
        <set_value name="$factions" exact="[faction.argon, faction.antigone, faction.hatikvah, faction.teladi, faction.ministry, faction.paranid, faction.holyorder, faction.trinity, faction.alliance, faction.terran, faction.pioneers, faction.boron, faction.split, faction.freesplit]"/>
        <!-- The ui lua sends a ';'-joined STRING (e.g. "argon;paranid" or "argon").
             Only STRINGS marshal Lua->MD (tables arrive NOTABLE, numbers are dropped —
             verified via tools/x4_probe.py). $keys is PARALLEL to $factions; resolve
             by string comparison / .indexof. -->
        <set_value name="$keys" exact="['argon', 'antigone', 'hatikvah', 'teladi', 'ministry', 'paranid', 'holyorder', 'trinity', 'alliance', 'terran', 'pioneers', 'boron', 'split', 'freesplit']"/>
        <set_value name="$in" exact="@event.param3"/>
        <do_if value="not $in?">
          <set_value name="$in" exact="''"/>
        </do_if>
        <!-- ALL primitives verified live via x4_probe (in arrives, count=14, list
             indexing + .name + random pick + string == all work). The ONLY thing that
             broke everything was `and` inside a do_while CONDITION — so NO `and` in any
             loop condition here; early-break is done by jumping the counters. `and` in
             a do_if is fine (used below). -->
        <set_value name="$cnt" exact="$factions.count"/>
        <set_value name="$facA" exact="null"/>
        <set_value name="$facB" exact="null"/>

        <!-- ONE named faction: $in == a single key (O(14), always safe). -->
        <set_value name="$i" exact="1"/>
        <do_while value="$i le $cnt">
          <do_if value="$in == $keys.{$i}">
            <set_value name="$facA" exact="$factions.{$i}"/>
          </do_if>
          <set_value name="$i" exact="$i + 1"/>
        </do_while>

        <!-- TWO named factions "keyI;keyJ" — only when not a single match and $in is
             non-empty (so single/none never run this loop). Break by jumping i,j. -->
        <do_if value="not $facA? and $in != ''">
          <set_value name="$i" exact="1"/>
          <do_while value="$i le $cnt">
            <set_value name="$j" exact="1"/>
            <do_while value="$j le $cnt">
              <do_if value="$i != $j and ($in == ($keys.{$i} + ';' + $keys.{$j}))">
                <set_value name="$facA" exact="$factions.{$i}"/>
                <set_value name="$facB" exact="$factions.{$j}"/>
                <set_value name="$i" exact="99"/>
                <set_value name="$j" exact="99"/>
              </do_if>
              <set_value name="$j" exact="$j + 1"/>
            </do_while>
            <set_value name="$i" exact="$i + 1"/>
          </do_while>
        </do_if>

        <!-- fill unset sides with random factions (random pick verified working). -->
        <do_if value="not $facA?">
          <set_value name="$r" min="1" max="$factions.count"/>
          <set_value name="$facA" exact="$factions.{$r}"/>
        </do_if>
        <do_if value="not $facB?">
          <set_value name="$facB" exact="$facA"/>
          <do_while value="$facB == $facA">
            <set_value name="$r" min="1" max="$factions.count"/>
            <set_value name="$facB" exact="$factions.{$r}"/>
          </do_while>
        </do_if>

        <!-- sour their standing (game diplomacy system) -->
        <set_value name="$pct" min="10" max="20"/>
        <set_value name="$delta" exact="-$pct / 100.0"/>
        <add_faction_relation faction="$facA" otherfaction="$facB" value="$delta"/>
        <debug_text text="'[Twitch] incident: %s vs %s (%s)'.[$facA.name, $facB.name, $delta]" filter="general"/>
        <signal_cue_instantly cue="Twitch_Say"
          param="'Diplomatic incident! Relations between ' + $facA.name + ' and ' + $facB.name + ' just soured.'"/>
      </actions>
    </cue>

    <!-- ===== outbound (game -> bridge -> Twitch) ============================ -->
    <!-- Build a minimal JSON line and write it to the pipe.
         NOTE: naive string build; escape $msg for quotes/backslashes before ship. -->
    <cue name="Twitch_Say" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$msg" exact="event.param"/>
        <!-- Trailing '\n' frames the line for the bridge's newline-delimited reader.
             X4's pipe write does NOT add one (verified live 2026-06-09: the probe saw
             24 bytes with no newline). MD supports '\n' escapes (cf. sn_mod_support_apis
             interact_menu_api.xml: `$msg + '\n'`). -->
        <set_value name="$json" exact="'{&quot;t&quot;:&quot;say&quot;,&quot;msg&quot;:&quot;' + $msg + '&quot;}' + '\n'"/>
        <signal_cue_instantly cue="md.Named_Pipes.Write"
          param="table[$pipe='twitch', $msg=$json, $cue=Twitch_OnWriteResult]"/>
      </actions>
    </cue>

    <cue name="Twitch_OnWriteResult" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="event.param != 'SUCCESS'">
          <debug_text text="'[Twitch] write failed: %s'.[event.param]" filter="general"/>
        </do_if>
      </actions>
    </cue>

  </cues>
</mdscript>
