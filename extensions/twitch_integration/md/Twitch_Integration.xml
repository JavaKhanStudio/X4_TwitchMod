<?xml version="1.0" encoding="utf-8"?>
<!--
  Twitch Integration — Mission Director script (game-logic layer).

  Responsibilities:
    * lifecycle: open the pipe and start a continuous read on game load
    * inbound:  raw line from pipe -> Lua (JSON decode) -> typed UI event -> MD cue -> effect
    * outbound: build a small JSON line and Named_Pipes.Write it back to the bridge

  Transport is the Mod Support APIs "Named Pipes API". On native Linux the bekopharm
  linux-compat fork backs that API with a Unix-domain socket in the savegame folder,
  so this same MD code works on Linux. The pipe NAME here ("twitch") maps to the
  socket file via the API's "Pipe Prefix Linux" option.

  VERIFIED against sn_mod_support_apis source:
    * md.Named_Pipes.Read  param="table[$pipe=.., $cue=.., $continuous=true]";
      callback reads the line from event.param ('ERROR'/'CANCELLED'/'TIMEOUT' sentinels).
    * md.Named_Pipes.Write param="table[$pipe=.., $msg=.., $cue=..]"; callback event.param
      is 'SUCCESS'/'ERROR'. No explicit open needed (connects on first access).
    * Lua-emitted typed events arrive with the payload in event.param3.
  STILL [VERIFY] live: (a) Linux pipe-name -> socket-file mapping via the fork's
  "Pipe Prefix Linux" option; (b) whether to pass structured fields as an MD table
  via param3 instead of the raw JSON string (see Twitch_OnChat).
  Effects below are debug log lines; real gameplay replaces the TODO markers.
-->
<mdscript name="Twitch_Integration" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>

    <!-- ===== lifecycle ===================================================== -->
    <cue name="Twitch_Reset" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'reloaded'"/>
      </conditions>
      <actions>
        <set_value name="$pipe" exact="'twitch'"/>
        <debug_text text="'[Twitch] lua reloaded; starting pipe read'" filter="general"/>
        <signal_cue_instantly cue="Twitch_StartReading"/>
      </actions>
    </cue>

    <cue name="Twitch_Init" instantiate="true">
      <conditions>
        <event_game_started/>
      </conditions>
      <actions>
        <signal_cue_instantly cue="Twitch_StartReading"/>
      </actions>
    </cue>

    <!-- Start a continuous read on the pipe; each line invokes Twitch_OnPipeData. -->
    <cue name="Twitch_StartReading" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- [VERIFY] continuous-read invocation per Named_Pipes_API.md -->
        <signal_cue_instantly cue="md.Named_Pipes.Read"
          param="table[$pipe='twitch', $cue=Twitch_OnPipeData, $continuous=true]"/>
      </actions>
    </cue>

    <!-- One raw line arrived from the bridge. Hand it to Lua to decode. -->
    <cue name="Twitch_OnPipeData" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$line" exact="event.param"/>
        <do_if value="$line == 'ERROR' or $line == 'CLOSED'">
          <debug_text text="'[Twitch] pipe error/closed; will retry'" filter="general"/>
          <!-- simple backoff then restart the read loop -->
          <signal_cue cue="Twitch_StartReading" delay="2s"/>
        </do_if>
        <do_else>
          <raise_lua_event name="'Twitch.Decode'" param="$line"/>
        </do_else>
      </actions>
    </cue>

    <!-- ===== inbound VETTED COMMANDS (one cue per catalog action id) ========
         The bridge applies permissions/cooldowns and sends {"t":"cmd","id":<action>,
         "by":<user>,"args":{...}}. Lua emits <action> as the `control`, so each
         action gets its own cue. event.param3 holds the raw JSON line.
         Add a cue here whenever you add a Command to bridge/twitch_bridge/catalog.py.
         Effects are debug_text placeholders — replace the TODOs with real gameplay. -->

    <cue name="Twitch_OnPing" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'ping'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] ping: %s'.[event.param3]" filter="general"/>
        <signal_cue_instantly cue="Twitch_Say" param="'pong'"/>
      </actions>
    </cue>

    <cue name="Twitch_OnSpawn" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'spawn'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] spawn: %s'.[event.param3]" filter="general"/>
        <!-- TODO: spawn a ship near the player; args.$ship holds the requested type -->
      </actions>
    </cue>

    <cue name="Twitch_OnPirateAttack" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'pirate_attack'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] pirate_attack: %s'.[event.param3]" filter="general"/>
        <!-- TODO: spawn a hostile pirate squad -->
      </actions>
    </cue>

    <cue name="Twitch_OnReinforcements" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'reinforcements'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] reinforcements: %s'.[event.param3]" filter="general"/>
        <!-- TODO: friendly reinforcements scaled by args.$viewers -->
        <signal_cue_instantly cue="Twitch_Say" param="'Thanks for the raid!'"/>
      </actions>
    </cue>

    <cue name="Twitch_OnSubReward" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'sub_reward'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] sub_reward: %s'.[event.param3]" filter="general"/>
        <!-- TODO: grant a perk to the player -->
      </actions>
    </cue>

    <cue name="Twitch_OnCheerBoost" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'Twitch_Integration'" control="'cheer_boost'"/>
      </conditions>
      <actions>
        <debug_text text="'[Twitch] cheer_boost: %s'.[event.param3]" filter="general"/>
        <!-- TODO: temporary boost scaled by args.$bits -->
      </actions>
    </cue>

    <!-- ===== outbound (game -> bridge -> Twitch) ============================ -->
    <!-- Build a minimal JSON line and write it to the pipe.
         NOTE: naive string build; escape $msg for quotes/backslashes before ship. -->
    <cue name="Twitch_Say" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$msg" exact="event.param"/>
        <set_value name="$json" exact="'{&quot;t&quot;:&quot;say&quot;,&quot;msg&quot;:&quot;' + $msg + '&quot;}'"/>
        <signal_cue_instantly cue="md.Named_Pipes.Write"
          param="table[$pipe='twitch', $msg=$json, $cue=Twitch_OnWriteResult]"/>
      </actions>
    </cue>

    <cue name="Twitch_OnWriteResult" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="event.param != 'SUCCESS'">
          <debug_text text="'[Twitch] write failed: %s'.[event.param]" filter="general"/>
        </do_if>
      </actions>
    </cue>

  </cues>
</mdscript>
