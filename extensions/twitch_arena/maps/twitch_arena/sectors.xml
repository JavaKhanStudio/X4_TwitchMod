<?xml version="1.0" encoding="utf-8"?>
<!-- The arena sector: one zone at the origin (where the player starts). More zones
     (a gate zone, a dock zone) arrive in iteration 2. -->
<macros>
  <macro name="twitcharena_sector_macro" class="sector">
    <component ref="standardsector" />
    <connections>
      <connection name="twitcharena_zone_connection" ref="zones">
        <offset>
          <position x="0" y="0" z="0" />
        </offset>
        <macro ref="twitcharena_zone_macro" connection="sector" />
      </connection>
    </connections>
  </macro>
</macros>
