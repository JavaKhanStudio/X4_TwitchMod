<?xml version="1.0" encoding="utf-8"?>
<!-- One cluster holding one sector, with a visual backdrop component (Cluster_01,
     a base-game environment reused by demo_universe). Regions (nebula/resources)
     are intentionally omitted in iteration 1 to keep the first load clean. -->
<macros>
  <macro name="twitcharena_cluster_macro" class="cluster">
    <component ref="standardcluster" />
    <connections>
      <connection name="twitcharena_sector_connection" ref="sectors">
        <macro ref="twitcharena_sector_macro" connection="cluster" />
      </connection>
      <connection ref="content">
        <macro>
          <component connection="space" ref="Cluster_01" />
        </macro>
      </connection>
    </connections>
  </macro>
</macros>
