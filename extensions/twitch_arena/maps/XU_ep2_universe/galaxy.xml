<?xml version="1.0" encoding="utf-8"?>
<!-- Attach the Twitch cluster to the MAIN galaxy (XU_EP2_universe_macro). This is a
     same-path diff against the base game's maps/XU_ep2_universe/galaxy.xml (the same
     mechanism our index/macros.xml uses to patch the base index).

     NOTE the exact macro-name case: the base file declares name="XU_EP2_universe_macro"
     (even though it is referenced elsewhere as xu_ep2_universe_macro); the diff sel
     is a literal string match, so it must match that case.

     Position x=250,000,000 is beyond the vanilla galaxy extent (max ~210M) so the
     cluster does not overlap anything on the galaxy map. A gate pair (added below +
     in the two zones.xml files) connects it to Grand Exchange I. -->
<diff>
  <add sel="/macros/macro[@name='XU_EP2_universe_macro']/connections">
    <connection name="twitchmain_cluster_connection" ref="clusters">
      <offset>
        <position x="250000000" y="0" z="0" />
      </offset>
      <macro ref="twitchmain_cluster_macro" connection="galaxy" />
    </connection>

    <!-- Bidirectional gate link: Grand Exchange I <-> Twitch sector. Path structure
         and the ../ counts mirror the base game's own inter-cluster gates
         (maps/demo_universe/demo_galaxy.xml <connection ref="destination">): the
         connection's path points at gate A (Grand Exchange), the inner <macro>
         path at gate B (Twitch). Both sectors have identical galaxy>cluster>sector>
         zone>gate depth, so the counts match the demo exactly. -->
    <connection name="connection_gate_ge_twitch" ref="destination"
                path="../Cluster_01_connection/Cluster_01_Sector001_connection/Zone001_Cluster_01_Sector001_connection/connection_gate_ge_to_twitch">
      <macro connection="destination"
             path="../../../../../twitchmain_cluster_connection/twitchmain_sector_connection/twitchmain_zone_connection/connection_gate_twitch_to_ge" />
    </connection>
  </add>
</diff>
