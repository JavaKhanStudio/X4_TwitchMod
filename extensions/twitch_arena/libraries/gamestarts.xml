<?xml version="1.0" encoding="utf-8"?>
<!-- Add a "Twitch Arena" new-game option. group="2" is the custom/creative group
     in the new-game menu (same as the base custom starts); image reused from the
     base custom start.

     HQ: placed by libraries/god.xml (a type="headquarters" god station gated to
     this gamestart). That is the vanilla mechanism (verified against the base
     game's own god.xml). CRITICAL: god must be ENABLED below for that station to
     spawn — with <god enabled="false"/> the HQ entry is silently ignored (this was
     the bug that made the HQ/Research never appear). Re-enabling god is safe here:
     every vanilla god station is bound to the vanilla galaxy (xu_ep2_universe_macro)
     or its cluster_* sectors, none to our twitcharena_* galaxy/sector, so nothing
     but our own HQ spawns in the arena. jobs+masstraffic stay disabled so no
     vanilla ships/traffic leak in.

     Ship: plain ship-drop — the player spawns in the Nemesis "Twitch One" at the
     sector origin; the HQ sits ~25km away (fly or teleport to it).

     Iteration 2: second Nemesis + weapon loadouts + a friendly dock + a gate
     out to the vanilla galaxy. -->
<diff>
  <add sel="/gamestarts">
    <gamestart id="twitcharena_start"
               name="Twitch Arena"
               description="A sealed single-sector arena — a contained stage for Twitch-driven spawns, waves and bounties. Starts you in one Nemesis with a Headquarters in-sector and the full research tree (teleportation, engine/shield/weapon mods) already unlocked."
               image="gamestart_custom_01" group="2" tags="">
      <!-- Plain ship-drop. The vanilla HQ-start form (station="...headquarters..."
           + <interior>) CRASHES new-game generation (~90%) in this custom sealed
           sector: those starts rely on a predefined HQ build spot baked into their
           vanilla sector, which our bare arena zone doesn't have. So the HQ is
           placed at RUNTIME by md/twitch_arena.xml instead; the gamestart just
           drops the player into Twitch One as before. -->
      <location galaxy="twitcharena_galaxy_macro" sector="twitcharena_sector_macro">
        <position x="0" y="0" z="0" />
      </location>
      <player macro="character_player_fight_macro" money="500000" name="Player">
        <ship macro="ship_par_m_corvette_01_a_macro" name="Twitch One" />
        <!-- Everything researched from the start: the arena is a creative sandbox,
             so we hand the player the whole PHQ research tree. Listing a research_*
             ware here marks it COMPLETED at game start (verified against the game's
             libraries/gamestarts.xml). The equipment-MOD lines (mod_engine / shield
             / weapon / ship) are the "mods research for shields and engines" ask;
             teleportation + range let you jump between owned ships and the HQ from
             the map (the HQ placed by md/twitch_arena.xml is what makes teleport +
             the Research menu actually usable). -->
        <research>
          <!-- teleportation -->
          <ware ware="research_teleportation" />
          <ware ware="research_teleportation_range_01" />
          <ware ware="research_teleportation_range_02" />
          <ware ware="research_teleportation_range_03" />
          <ware ware="research_high_mass_teleportation" />
          <!-- equipment mods: engines / shields / weapons / ship -->
          <ware ware="research_mod_engine_mk1" />
          <ware ware="research_mod_engine_mk2" />
          <ware ware="research_mod_engine_mk3" />
          <ware ware="research_mod_shield_mk1" />
          <ware ware="research_mod_shield_mk2" />
          <ware ware="research_mod_shield_mk3" />
          <ware ware="research_mod_weapon_mk1" />
          <ware ware="research_mod_weapon_mk2" />
          <ware ware="research_mod_weapon_mk3" />
          <ware ware="research_mod_ship_mk1" />
          <ware ware="research_mod_ship_mk2" />
          <ware ware="research_mod_ship_mk3" />
          <!-- HQ warp + station-module + QoL research -->
          <ware ware="research_warp_hq_01" />
          <ware ware="research_warp_hq_02" />
          <ware ware="research_module_build" />
          <ware ware="research_module_production" />
          <ware ware="research_module_storage" />
          <ware ware="research_module_dock" />
          <ware ware="research_module_defence" />
          <ware ware="research_module_habitation" />
          <ware ware="research_module_venture" />
          <ware ware="research_module_welfare_1" />
          <ware ware="research_module_welfare_2" />
          <ware ware="research_radioreceiver" />
          <ware ware="research_sensorbooster" />
          <ware ware="research_tradeinterface" />
          <ware ware="research_seta" />
        </research>
      </player>
      <universe ventures="false" visitors="false" onlineinventory="false">
        <jobs enabled="false" />
        <!-- god ENABLED so libraries/god.xml can place our player HQ. Safe: no
             vanilla god content targets the arena galaxy/sector (all bound to
             xu_ep2_universe_macro / cluster_* sectors). -->
        <god enabled="true" />
        <masstraffic enabled="false" />
      </universe>
    </gamestart>

    <!-- Twitch Sector (MAIN universe). A second start whose sector lives inside
         XU_EP2_universe_macro (attached via maps/XU_ep2_universe/galaxy.xml), so the
         HQ's Research menu + teleportation work NATIVELY here (unlike the sealed
         arena, where those systems are galaxy-gated off). The living universe is
         left ENABLED (no <universe> overrides): jobs/god run everywhere as normal.
         A gate connects the Twitch sector to Grand Exchange I (see the two
         maps/XU_ep2_universe/*.xml diffs). HQ is placed by libraries/god.xml, made
         operational by md/twitch_arena.xml. -->
    <gamestart id="twitchmain_start"
               name="Twitch Sector"
               description="Start in a Twitch sector inside the main universe, in one Nemesis, with a working Headquarters in-sector and the full research tree (teleportation, engine/shield/weapon mods) unlocked. Unlike the sealed Twitch Arena, HQ research and teleportation function normally here."
               image="gamestart_custom_01" group="2" tags="">
      <location galaxy="xu_ep2_universe_macro" sector="twitchmain_sector_macro">
        <position x="0" y="0" z="0" />
      </location>
      <player macro="character_player_fight_macro" money="500000" name="Player">
        <ship macro="ship_par_m_corvette_01_a_macro" name="Twitch One" />
        <research>
          <ware ware="research_teleportation" />
          <ware ware="research_teleportation_range_01" />
          <ware ware="research_teleportation_range_02" />
          <ware ware="research_teleportation_range_03" />
          <ware ware="research_high_mass_teleportation" />
          <ware ware="research_mod_engine_mk1" />
          <ware ware="research_mod_engine_mk2" />
          <ware ware="research_mod_engine_mk3" />
          <ware ware="research_mod_shield_mk1" />
          <ware ware="research_mod_shield_mk2" />
          <ware ware="research_mod_shield_mk3" />
          <ware ware="research_mod_weapon_mk1" />
          <ware ware="research_mod_weapon_mk2" />
          <ware ware="research_mod_weapon_mk3" />
          <ware ware="research_mod_ship_mk1" />
          <ware ware="research_mod_ship_mk2" />
          <ware ware="research_mod_ship_mk3" />
          <ware ware="research_warp_hq_01" />
          <ware ware="research_warp_hq_02" />
          <ware ware="research_module_build" />
          <ware ware="research_module_production" />
          <ware ware="research_module_storage" />
          <ware ware="research_module_dock" />
          <ware ware="research_module_defence" />
          <ware ware="research_module_habitation" />
          <ware ware="research_radioreceiver" />
          <ware ware="research_sensorbooster" />
          <ware ware="research_tradeinterface" />
          <ware ware="research_seta" />
        </research>
      </player>
      <!-- Mark the HQ mentor story states as done. This is the PROPER hook: the base
           game's mentor script reads $story_hq_boso = gamestart.storystate.story_hq_boso
           at its Start, and story_diplomacy_intro reads gamestart.storystate.story_hq_dal;
           when set, they find our god-placed player HQ (find_station_by_true_owner on
           station_pla_headquarters_base_01_macro) and install Boso + Dal through their
           own event flow — dynamic tank room, NPC placement, research unlock and all.
           Works because we are in the main galaxy (that whole system is galaxy-gated).
           Schema: universe/stories/story@ref@state (libraries/gamestarts.xsd,
           gamestartuniversestorystates). No jobs/god overrides here -> living universe
           stays enabled (needed for god to place the HQ). -->
      <universe>
        <stories>
          <story ref="story_hq_boso" state="1" />
          <story ref="story_hq_dal" state="1" />
          <!-- Diplomacy network already established (base game). -->
          <story ref="story_diplomacy_network" state="1" />
          <!-- Envoy situation already done (ego_dlc_mini_02 / Hyperion). -->
          <story ref="story_envoy" state="1" />
          <!-- Timelines situation advanced to Grandmother (ego_dlc_timelines).
               The other timelines point is story_timelines_quettanaut. -->
          <story ref="story_timelines_grandmother" state="1" />
        </stories>
      </universe>
    </gamestart>
  </add>
</diff>
