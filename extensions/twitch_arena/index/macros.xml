<?xml version="1.0" encoding="utf-8"?>
<!-- Register the arena's macros so the engine can resolve them by name. Without
     these entries the galaxy/cluster/sector/zone macros are "unknown". Names are
     lowercase; values are the file paths (no extension, backslashes) — same form
     the base game uses for maps\demo_universe\* in index/macros.xml. -->
<diff>
  <add sel="/index">
    <entry name="twitcharena_galaxy_macro" value="extensions\twitch_arena\maps\twitch_arena\galaxy" />
    <entry name="twitcharena_cluster_macro" value="extensions\twitch_arena\maps\twitch_arena\clusters" />
    <entry name="twitcharena_sector_macro" value="extensions\twitch_arena\maps\twitch_arena\sectors" />
    <entry name="twitcharena_zone_macro" value="extensions\twitch_arena\maps\twitch_arena\zones" />
    <!-- Main-universe Twitch sector (attached to XU_EP2_universe_macro via
         maps\XU_ep2_universe\galaxy.xml). The galaxy macro itself is vanilla, so
         only the new cluster/sector/zone are registered here. -->
    <entry name="twitchmain_cluster_macro" value="extensions\twitch_arena\maps\twitchmain\clusters" />
    <entry name="twitchmain_sector_macro" value="extensions\twitch_arena\maps\twitchmain\sectors" />
    <entry name="twitchmain_zone_macro" value="extensions\twitch_arena\maps\twitchmain\zones" />
  </add>
</diff>
